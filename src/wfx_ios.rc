#include <windows.h>
#include "resource.h"

/* WFX_VERSION_* come from version.txt through CMake. */
#ifndef WFX_VERSION_STR
#define WFX_VERSION_STR "0.0"
#define WFX_VERSION_MAJOR 0
#define WFX_VERSION_MINOR 0
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_PLUGIN ICON "../res/wfx_ios.ico"

/* The texts here are the English defaults; dialogs.c replaces them with the current language. */
IDD_SETTINGS DIALOGEX 0, 0, 280, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iOS plugin settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Device", IDC_GRP_DEVICE, 7, 7, 266, 92
    LTEXT           "&Use:", IDC_LBL_USE, 15, 23, 34, 8
    COMBOBOX        IDC_DEVICE, 52, 21, 156, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Refresh", IDC_REFRESH, 213, 20, 52, 14
    LTEXT           "", IDC_INFO, 15, 41, 250, 52

    GROUPBOX        "Options", IDC_GRP_OPTIONS, 7, 103, 266, 102
    AUTOCHECKBOX    "Show applications by &name instead of bundle id", IDC_APPNAMES, 15, 117, 250, 10
    AUTOCHECKBOX    "List &all applications (most will not open)", IDC_ALLAPPS, 15, 130, 250, 10
    AUTOCHECKBOX    "Use devices over &Wi-Fi when none is on USB (can be slow)", IDC_WIFI, 15, 143, 250, 10
    AUTOCHECKBOX    "Write a &log file", IDC_LOG, 15, 156, 250, 10
    AUTOCHECKBOX    "Include the full protocol &trace in the log (large, slow)", IDC_DEBUG, 15, 169, 250, 10
    LTEXT           "Lan&guage:", IDC_LBL_LANG, 15, 187, 44, 8
    COMBOBOX        IDC_LANGUAGE, 62, 185, 110, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_ABOUT, 7, 211, 266, 8
    PUSHBUTTON      "Open lo&g", IDC_OPENLOG, 7, 229, 70, 14
    DEFPUSHBUTTON   "OK", IDOK, 163, 229, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 221, 229, 52, 14
END

/* File properties: read-only fields, so that values can be selected and copied. */
IDD_PROPERTIES DIALOGEX 0, 0, 272, 161
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Name:", IDC_PL_NAME, 9, 9, 62, 8
    EDITTEXT        IDC_P_NAME, 74, 9, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "On device:", IDC_PL_PATH, 9, 23, 62, 8
    EDITTEXT        IDC_P_PATH, 74, 23, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Type:", IDC_PL_TYPE, 9, 37, 62, 8
    EDITTEXT        IDC_P_TYPE, 74, 37, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Size:", IDC_PL_SIZE, 9, 51, 62, 8
    EDITTEXT        IDC_P_SIZE, 74, 51, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Created:", IDC_PL_CREATED, 9, 65, 62, 8
    EDITTEXT        IDC_P_CREATED, 74, 65, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Modified:", IDC_PL_MODIFIED, 9, 79, 62, 8
    EDITTEXT        IDC_P_MODIFIED, 74, 79, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Hard links:", IDC_PL_LINKS, 9, 93, 62, 8
    EDITTEXT        IDC_P_LINKS, 74, 93, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Blocks:", IDC_PL_BLOCKS, 9, 107, 62, 8
    EDITTEXT        IDC_P_BLOCKS, 74, 107, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Link target:", IDC_PL_TARGET, 9, 121, 62, 8
    EDITTEXT        IDC_P_TARGET, 74, 121, 189, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    DEFPUSHBUTTON   "OK", IDOK, 215, 141, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION WFX_VERSION_MAJOR,WFX_VERSION_MINOR,0,0
PRODUCTVERSION WFX_VERSION_MAJOR,WFX_VERSION_MINOR,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "iOS file system plugin for Total Commander"
            VALUE "FileVersion", WFX_VERSION_STR
            VALUE "ProductName", "wfx_iOS"
            VALUE "ProductVersion", WFX_VERSION_STR
            VALUE "Comments", "Update of wfx_iOS 1.3 by Domo (original author)"
            VALUE "LegalCopyright", "LGPL-2.1-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
