#include <windows.h>
#include "resource.h"

/* WFX_VERSION_* come from version.txt through CMake. */
#ifndef WFX_VERSION_STR
#define WFX_VERSION_STR "0.0"
#define WFX_VERSION_MAJOR 0
#define WFX_VERSION_MINOR 0
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_PLUGIN ICON "../res/wfx_ios.ico"

IDD_SETTINGS DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iOS plugin settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Device", -1, 7, 7, 266, 92
    LTEXT           "&Use:", -1, 15, 23, 20, 8
    COMBOBOX        IDC_DEVICE, 38, 21, 174, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Refresh", IDC_REFRESH, 217, 20, 48, 14
    LTEXT           "", IDC_INFO, 15, 41, 250, 52

    GROUPBOX        "Options", -1, 7, 103, 266, 84
    AUTOCHECKBOX    "Show applications by &name instead of bundle id", IDC_APPNAMES, 15, 117, 250, 10
    AUTOCHECKBOX    "List &all applications (most will not open)", IDC_ALLAPPS, 15, 130, 250, 10
    AUTOCHECKBOX    "Use devices over &Wi-Fi when none is on USB (can be slow)", IDC_WIFI, 15, 143, 250, 10
    AUTOCHECKBOX    "Write a &log file", IDC_LOG, 15, 156, 250, 10
    AUTOCHECKBOX    "Include the full protocol &trace in the log (large, slow)", IDC_DEBUG, 15, 169, 250, 10

    LTEXT           "", IDC_ABOUT, 7, 193, 266, 8
    PUSHBUTTON      "Open lo&g", IDC_OPENLOG, 7, 211, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 169, 211, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 211, 50, 14
END

/* File properties: read-only fields, so that values can be selected and copied. */
IDD_PROPERTIES DIALOGEX 0, 0, 272, 161
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Name:", -1, 9, 9, 46, 8
    EDITTEXT        IDC_P_NAME, 58, 9, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "On device:", -1, 9, 23, 46, 8
    EDITTEXT        IDC_P_PATH, 58, 23, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Type:", -1, 9, 37, 46, 8
    EDITTEXT        IDC_P_TYPE, 58, 37, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Size:", -1, 9, 51, 46, 8
    EDITTEXT        IDC_P_SIZE, 58, 51, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Created:", -1, 9, 65, 46, 8
    EDITTEXT        IDC_P_CREATED, 58, 65, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Modified:", -1, 9, 79, 46, 8
    EDITTEXT        IDC_P_MODIFIED, 58, 79, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Hard links:", -1, 9, 93, 46, 8
    EDITTEXT        IDC_P_LINKS, 58, 93, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Blocks:", -1, 9, 107, 46, 8
    EDITTEXT        IDC_P_BLOCKS, 58, 107, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Link target:", -1, 9, 121, 46, 8
    EDITTEXT        IDC_P_TARGET, 58, 121, 205, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    DEFPUSHBUTTON   "OK", IDOK, 215, 141, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION WFX_VERSION_MAJOR,WFX_VERSION_MINOR,0,0
PRODUCTVERSION WFX_VERSION_MAJOR,WFX_VERSION_MINOR,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "iOS file system plugin for Total Commander"
            VALUE "FileVersion", WFX_VERSION_STR
            VALUE "ProductName", "wfx_iOS"
            VALUE "ProductVersion", WFX_VERSION_STR
            VALUE "Comments", "Update of wfx_iOS 1.3 by Domo (original author)"
            VALUE "LegalCopyright", "LGPL-2.1-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
