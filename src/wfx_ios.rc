#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_PLUGIN ICON "../res/wfx_ios.ico"

IDD_SETTINGS DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iOS plugin settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Device", -1, 7, 7, 266, 92
    LTEXT           "&Use:", -1, 15, 23, 20, 8
    COMBOBOX        IDC_DEVICE, 38, 21, 174, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Refresh", IDC_REFRESH, 217, 20, 48, 14
    LTEXT           "", IDC_INFO, 15, 41, 250, 52

    GROUPBOX        "Options", -1, 7, 103, 266, 84
    AUTOCHECKBOX    "Show applications by &name instead of bundle id", IDC_APPNAMES, 15, 117, 250, 10
    AUTOCHECKBOX    "List &all applications (most will not open)", IDC_ALLAPPS, 15, 130, 250, 10
    AUTOCHECKBOX    "Use devices over &Wi-Fi when none is on USB (can be slow)", IDC_WIFI, 15, 143, 250, 10
    AUTOCHECKBOX    "Write a &log file", IDC_LOG, 15, 156, 250, 10
    AUTOCHECKBOX    "Include the full protocol &trace in the log (large, slow)", IDC_DEBUG, 15, 169, 250, 10

    LTEXT           "", IDC_ABOUT, 7, 193, 266, 8
    PUSHBUTTON      "Open lo&g", IDC_OPENLOG, 7, 211, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 169, 211, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 211, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "iOS file system plugin for Total Commander"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "ProductName", "wfx_iOS"
            VALUE "ProductVersion", "2.0"
            VALUE "Comments", "Update of wfx_iOS 1.3 by Domo (original author)"
            VALUE "LegalCopyright", "LGPL-2.1-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
